# UNS UI Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# All environment variables must be prefixed with VITE_ to be exposed to the browser.
# See: https://vitejs.dev/guide/env-and-mode.html

# Base URL for UNS API endpoints
# The UI proxies /ui/* requests to this URL during development.
# In production, set this to the deployed API server URL.
VITE_UNS_API_BASE_URL=http://localhost:8000
