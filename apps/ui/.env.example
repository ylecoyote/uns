# No environment file is required by the current console client.
# Requests use same-origin /ui; vite.config.ts proxies to http://localhost:8000 in development.
# Historical VITE_UNS_API_BASE_URL is not read by the current client.
# Never put API credentials in VITE_ variables: they can be embedded in browser output.
# Enter the operator key at runtime; the console keeps it in tab memory only.
